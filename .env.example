# 此文件只描述 development；production 请使用 deploy/production.env.example，并由部署平台注入真实秘密。
# PostgreSQL: host endpoint is used by processes running on Windows;
# Docker endpoint is used by containers.
DATABASE_URL=postgresql://agent_runtime_local:replace-me@127.0.0.1:5432/agent_runtime_dev
DATABASE_DOCKER_URL=postgresql://agent_runtime_local:replace-me@host.docker.internal:5432/agent_runtime_dev
DATABASE_BOOTSTRAP_URL=postgresql://database_admin:replace-me@127.0.0.1:5432/agent_runtime_dev
MIGRATION_DATABASE_URL=postgresql://agent_runtime_migrator_local:replace-me@127.0.0.1:5432/agent_runtime_dev
DATABASE_RUNTIME_ROLE=agent_runtime_local
DATABASE_WORKER_COORDINATOR_URL=postgresql://agent_worker_coordinator_local:replace-me@127.0.0.1:5432/agent_runtime_dev
DATABASE_WORKER_COORDINATOR_ROLE=agent_worker_coordinator_local
DATABASE_TEAM_COORDINATOR_URL=postgresql://agent_team_coordinator_local:replace-me@127.0.0.1:5432/agent_runtime_dev
DATABASE_TEAM_COORDINATOR_ROLE=agent_team_coordinator_local
DATABASE_MIGRATOR_ROLE=agent_runtime_migrator_local
DATABASE_SKILL_PUBLISHER_ROLE=agent_skill_publisher_local
DATABASE_SCHEMA=agent_runtime
RUNTIME_ENV=development
PROCESS_SHUTDOWN_TIMEOUT_MS=15000

# Opaque cursor key ring; values here must remain placeholders.
THREAD_CURSOR_ACTIVE_KID=development-current
THREAD_CURSOR_SIGNING_KEYS=replace-with-cursor-signing-key-ring
THREAD_SERIAL_QUEUE_V2_ENABLED=true
THREAD_CONTEXT_V2_WRITE_ENABLED=true
THREAD_CONTEXT_V2_SHADOW_READ_ENABLED=true
THREAD_CONTEXT_V2_READ_ENABLED=true
THREAD_INPUT_ROUTING_V2_ENABLED=true
THREAD_CONTEXT_INLINE_BODY_MAX_BYTES=16384
THREAD_CONTEXT_COMPACTION_ENABLED=true
THREAD_CONTEXT_COMPACTION_PATH=local
THREAD_CONTEXT_COMPACTION_SOFT_LIMIT_PERCENT=80
THREAD_CONTEXT_COMPACTION_TARGET_PERCENT=55
THREAD_CONTEXT_COMPACTION_RECENT_USER_TOKENS=4096
THREAD_CONTEXT_COMPACTION_MAX_OUTPUT_TOKENS=16384
THREAD_CONTEXT_COMPACTION_TIMEOUT_MS=60000
THREAD_SANDBOX_SESSION_REUSE_ENABLED=true
SUBAGENTS_ENABLED=true
THREAD_SANDBOX_RETENTION_SCHEDULER_ENABLED=true
CUBESANDBOX_SESSION_TTL_SECONDS=43800
THREAD_SANDBOX_PAUSED_RETENTION_SECONDS=86400
THREAD_SANDBOX_LIFECYCLE_TIMEOUT_MS=90000
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=3001
# API 与 Cubelet 宿主机 Volume 插件共享；插件 endpoint 在节点 root 配置中单独设置。
RESOURCE_FILESYSTEM_SIGNING_KEY=replace-with-at-least-32-byte-resource-filesystem-key
HISTORY_FILESYSTEM_ENABLED=true
HISTORY_DIRECTORY_TIME_ZONE=Asia/Shanghai
# personal Tenant 首条 durable 输入异步生成 UI/历史目录标题；独立低成本模型不读取附件正文。
HISTORY_TITLE_GENERATION_ENABLED=true
HISTORY_TITLE_MODEL_BASE_URL=https://title-model.example.invalid/v1
HISTORY_TITLE_MODEL_API_KEY=replace-with-development-title-model-api-key
HISTORY_TITLE_MODEL_ID=replace-with-development-title-model-id
HISTORY_TITLE_MODEL_TIMEOUT_MS=20000
HISTORY_TITLE_INPUT_MAX_BYTES=4096
HISTORY_TITLE_MAX_OUTPUT_TOKENS=128
HISTORY_TITLE_MAX_ATTEMPTS=3
HISTORY_TITLE_RETRY_BASE_MS=5000
HISTORY_TITLE_POLL_INTERVAL_MS=1000
HISTORY_TITLE_CLAIM_LEASE_MS=60000
# development API 同进程托管的 HTTPS Sidecar；监听地址须能被 Cubelet 节点访问。
RESOURCEFS_PROXY_ENABLED=true
RESOURCEFS_PROXY_LISTEN_HOST=192.0.2.10
RESOURCEFS_PROXY_LISTEN_PORT=13443
RESOURCEFS_PROXY_TLS_KEY_PATH=replace-with-absolute-development-resourcefs-key-path
RESOURCEFS_PROXY_TLS_CERT_PATH=replace-with-absolute-development-resourcefs-cert-path

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=replace-with-dev-access-key
MINIO_ROOT_PASSWORD=replace-with-dev-secret-key
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
S3_ENDPOINT=http://127.0.0.1:19000
S3_DOCKER_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=agent-runtime-dev
S3_ACCESS_KEY_ID=replace-with-dev-access-key
S3_SECRET_ACCESS_KEY=replace-with-dev-secret-key
S3_FORCE_PATH_STYLE=true

# Skill 管理发布服务使用独立数据库登录与对象存储凭据，不能复用 Runtime/Migrator 或普通 S3 凭据。
SKILL_PUBLISHER_DATABASE_URL=postgresql://agent_skill_publisher_local:replace-me@127.0.0.1:5432/agent_runtime_dev
SKILL_PUBLISHER_S3_ENDPOINT=http://127.0.0.1:19000
SKILL_PUBLISHER_S3_BUCKET=agent-runtime-dev
SKILL_PUBLISHER_S3_REGION=us-east-1
SKILL_PUBLISHER_S3_ACCESS_KEY_ID=replace-with-dev-skill-publisher-access-key
SKILL_PUBLISHER_S3_SECRET_ACCESS_KEY=replace-with-dev-skill-publisher-secret-key
SKILL_PUBLISHER_S3_FORCE_PATH_STYLE=true
SKILL_ADMIN_LISTEN_HOST=127.0.0.1
SKILL_ADMIN_LISTEN_PORT=3002
DEV_SKILL_ADMIN_USER_ID=skill_admin_dev
DEV_SKILL_ADMIN_TOKEN=replace-with-dev-skill-admin-token

# CubeSandbox
SANDBOX_DEFAULT_PROVIDER=cube
SANDBOX_ENABLED_PROVIDERS=cube
CUBESANDBOX_API_URL=http://192.168.53.128:3000
CUBESANDBOX_WEB_URL=http://192.168.53.128:12088
CUBESANDBOX_TEMPLATE_ID=replace-with-template-id
# 可选：留空表示自托管 CubeSandbox 不要求 API Key，Proxy 参数留空时由 SDK 安全推导。
CUBESANDBOX_API_KEY=
CUBESANDBOX_PROXY_NODE_IP=
CUBESANDBOX_PROXY_PORT=
CUBESANDBOX_PROXY_SCHEME=
# Cube >= 0.6，CubeMaster/Cubelet 两侧注册的只读 ResourceFS Volume driver。
CUBESANDBOX_RESOURCE_VOLUME_DRIVER=runtime-resourcefs

# E2B Provider；启用时 Worker 需要 API Key 与模板，Scheduler 只需要 API Key。
E2B_API_KEY=replace-with-e2b-api-key
E2B_DOMAIN=
E2B_TEMPLATE_ID=replace-with-e2b-template-id

# Scheduler Cleanup：单进程只消费明确 Tenant，不能扫描或绕过 RLS。
# 本地工作台默认由 user-a 发起任务，Scheduler 必须消费同一个 Tenant。
SCHEDULER_TENANT_ID=tenant_a
SCHEDULER_WORKER_ID=scheduler_cleanup_dev
CLEANUP_POLL_INTERVAL_MS=1000
CLEANUP_LEASE_MS=210000

# Agent Worker：单进程只消费明确 Tenant 的 durable Run dispatch。
# 必须与 DEV_AUTH_USER_A_TENANT_ID 一致，Worker 只消费 dev-user-a 创建的 Run。
AGENT_WORKER_TENANT_ID=tenant_a
AGENT_WORKER_ID=agent_worker_dev
AGENT_WORKER_POLL_INTERVAL_MS=1000
AGENT_WORKER_DISPATCH_LEASE_MS=300000
AGENT_WORKER_RUN_LEASE_MS=30000
AGENT_WORKER_RUN_TIMEOUT_MS=43200000

# Mem0 Platform 仅用于合成/脱敏开发数据；默认关闭。API Key 与 scope HMAC Key 不得复用。
MEM0_MEMORY_ENABLED=false
MEM0_API_BASE_URL=https://api.mem0.ai/
MEM0_API_KEY=replace-with-development-mem0-project-api-key
MEM0_SCOPE_HMAC_KEY=replace-with-at-least-32-byte-development-memory-scope-key
MEM0_REQUEST_TIMEOUT_MS=5000

# Model provider
MODEL_BASE_URL=https://example.invalid/v1
MODEL_API_KEY=replace-with-model-api-key
MODEL_ID=replace-with-model-id
# 模型注册表的显式能力事实；视觉模型会在当前 user turn 自动收到全部图片附件。
MODEL_SUPPORTS_IMAGES=false
MODEL_CONTEXT_WINDOW=128000
MODEL_MAX_OUTPUT_TOKENS=16384
# 默认关闭：原始模型 prompt/SSE 可能含用户内容，仅在受控诊断窗口显式启用。
MODEL_WIRE_TRACE_ENABLED=false
MODEL_WIRE_TRACE_RETENTION_DAYS=7
# 最终 Fetch request body，或 HTTP content-decoding 后、SSE 解析前 response body 的诊断保存上限；超过保存前缀并标记截断。
MODEL_WIRE_TRACE_MAX_BYTES=1048576

# Fixed local identities used only by development isolation tests
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_A_ID=user_a
DEV_AUTH_USER_A_TENANT_ID=tenant_a
DEV_AUTH_USER_B_ID=user_b
DEV_AUTH_USER_B_TENANT_ID=tenant_b
