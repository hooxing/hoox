FROM node:24.18.0-bookworm-slim

WORKDIR /opt/process-gate

COPY runtime-ts/packages/process-runtime/dist/index.js ./process-runtime/index.js
COPY runtime-ts/packages/process-runtime/dist/environment.js ./process-runtime/environment.js
COPY runtime-ts/packages/process-runtime/dist/lifecycle.js ./process-runtime/lifecycle.js
COPY runtime-ts/packages/process-runtime/dist/service-process.js ./process-runtime/service-process.js
COPY runtime-ts/packages/process-runtime/package.json ./process-runtime/package.json
COPY scripts/process-container-gate.mjs ./process-container-gate.mjs

USER node

CMD ["node", "process-container-gate.mjs"]
