# Node 官方 24.18.0 bookworm-slim 多架构 manifest；digest 由本地 Docker RepoDigests
# `node@sha256:6f7b...1452d` 复核，静态发布 Gate 会拒绝 tag-only 或漂移值。
FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS build

WORKDIR /opt/runtime
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json .pnpmfile.cjs ./
RUN pnpm fetch --frozen-lockfile

COPY runtime-ts ./runtime-ts
COPY scripts/prune-production-deployment.mjs ./scripts/prune-production-deployment.mjs

# 安装严格服从锁文件；deploy 只生成 Worker 的 production 闭包，随后移除源码、测试与构建产物。
RUN --network=none pnpm install --offline --frozen-lockfile \
 && pnpm --filter @hoox/agent-worker^... build \
 && pnpm --filter @hoox/agent-worker build \
 && pnpm --filter @hoox/agent-worker deploy --prod /opt/deploy \
 && node scripts/prune-production-deployment.mjs /opt/deploy worker

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

WORKDIR /opt/runtime
ENV NODE_ENV=production \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
LABEL org.opencontainers.image.base.digest="sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d" \
      org.opencontainers.image.sbom="/opt/runtime/sbom/cyclonedx.json"

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx

COPY --chown=0:0 scripts/production-entrypoint.sh /usr/local/bin/production-entrypoint
RUN chmod 0555 /usr/local/bin/production-entrypoint
COPY --from=build --chown=0:0 /opt/deploy/ ./
COPY --chown=0:0 LICENSE NOTICE THIRD_PARTY_NOTICES.md ./licenses/hoox/
COPY --chown=0:0 third_party/pi/LICENSE third_party/pi/SOURCE.md ./licenses/third-party/pi/
COPY --chown=0:0 supply-chain/sbom/worker.cdx.json ./sbom/cyclonedx.json
COPY --chown=0:0 runtime-ts/vendor/cubesandbox-sdk/LICENSE ./licenses/vendor/cubesandbox-sdk/LICENSE
COPY --chown=0:0 runtime-ts/vendor/cubesandbox-sdk/SOURCE.md ./licenses/vendor/cubesandbox-sdk/SOURCE.md
COPY --chown=0:0 runtime-ts/vendor/cubesandbox-sdk/PATCHES/ ./licenses/vendor/cubesandbox-sdk/PATCHES/
COPY --chown=0:0 runtime-ts/vendor/deepseek-v4-tokenizer/LICENSE ./licenses/vendor/deepseek-v4-tokenizer/LICENSE
COPY --chown=0:0 runtime-ts/vendor/deepseek-v4-tokenizer/SOURCE.md ./licenses/vendor/deepseek-v4-tokenizer/SOURCE.md
RUN chown -R 0:0 /opt/runtime && chmod -R a-w /opt/runtime

# Node 官方镜像的 node 用户为固定非 root UID；以数字 UID 避免名称被镜像层改写。
USER 1000:1000

ENTRYPOINT ["/usr/local/bin/production-entrypoint"]
CMD ["node", "dist/production-main.js"]
