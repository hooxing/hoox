{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.arts",
      "!!.codeartsdoer",
      "!!.tmp",
      "!!exports",
      "!!model-wire-traces",
      "!!**/dist",
      "!!**/node_modules",
      "!!runtime-ts/vendor/cubesandbox-sdk",
      "!!runtime-ts/vendor/deepseek-v4-tokenizer/tokenizer.json",
      "!!runtime-ts/vendor/deepseek-v4-tokenizer/tokenizer_config.json",
      "!!runtime-ts/vendor/deepseek-trajectory",
      "!!runtime-ts/vendor/deepseek-markdown/src",
      "!!runtime-ts/packages/protocol/src/pi-model-catalog.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
