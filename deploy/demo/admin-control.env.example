# 服务器生成此文件，不要提交真实值。Admin Control 与 API 必须共享 BETTER_AUTH_SECRET。
RUNTIME_ENV=development
ADMIN_CONTROL_DATABASE_URL=postgresql://hoox_demo_admin_control:replace-with-random-admin-control-password@127.0.0.1:15432/hoox_demo
SKILL_PUBLISHER_DATABASE_URL=postgresql://hoox_demo_skill_publisher:replace-with-random-skill-password@127.0.0.1:15432/hoox_demo
DATABASE_ADMIN_CONTROL_ROLE=hoox_demo_admin_control
DATABASE_SKILL_PUBLISHER_ROLE=hoox_demo_skill_publisher
DATABASE_SCHEMA=agent_runtime
BETTER_AUTH_SECRET=replace-with-the-same-secret-as-api-env-at-least-32-bytes
ADMIN_CONTROL_LISTEN_HOST=127.0.0.1
ADMIN_CONTROL_LISTEN_PORT=3003
# 轨迹 Blob 读取使用与 Worker 相同的对象桶；独立于下面的 Skill 发布凭据。
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=agent-runtime-demo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-random-s3-user
S3_SECRET_ACCESS_KEY=replace-with-random-s3-password
S3_FORCE_PATH_STYLE=true
SKILL_PUBLISHER_S3_ENDPOINT=http://127.0.0.1:19000
SKILL_PUBLISHER_S3_BUCKET=agent-runtime-demo
SKILL_PUBLISHER_S3_REGION=us-east-1
SKILL_PUBLISHER_S3_ACCESS_KEY_ID=replace-with-random-skill-publisher-s3-user
SKILL_PUBLISHER_S3_SECRET_ACCESS_KEY=replace-with-random-skill-publisher-s3-password
SKILL_PUBLISHER_S3_FORCE_PATH_STYLE=true
DEV_ADMIN_CONTROL_TOKEN=replace-with-random-server-side-admin-token
MODEL_API_KEY=replace-with-model-provider-key
MODEL_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-byte-model-credential-master-key
PROCESS_SHUTDOWN_TIMEOUT_MS=10000
