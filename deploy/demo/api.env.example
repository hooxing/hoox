RUNTIME_ENV=development
DEMO_PUBLIC_ACCESS_ENABLED=true
DEMO_PUBLIC_ORIGIN=https://hoox.aisay.cc
# 发布脚本会用 Demo 账号对应的用户 ID 覆盖此占位值。
DEMO_ADMIN_USER_ID=user_demo_pending
DEV_AUTH_ENABLED=false
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=3001
BETTER_AUTH_TRUSTED_ORIGINS=https://hoox.aisay.cc
S3_ENDPOINT=http://127.0.0.1:19000
S3_PUBLIC_ENDPOINT=https://hoox.aisay.cc
S3_BUCKET=agent-runtime-demo
S3_FORCE_PATH_STYLE=true
RESOURCEFS_PROXY_ENABLED=false
# 其余数据库、游标、对象存储密钥与功能开关由服务器 shared/api.env 注入。
