# Scheduler 专用配置；签名加密根必须与 api.env 中的值相同。
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-byte-webhook-secret-master-key
DATABASE_WEBHOOK_DISPATCHER_ROLE=hoox_demo_webhook_dispatcher
DATABASE_TRAJECTORY_DIRECTORY_ROLE=hoox_demo_trajectory_directory
WEBHOOK_DISPATCHER_DATABASE_URL=postgresql://hoox_demo_webhook_dispatcher:replace-with-password@127.0.0.1:15432/hoox_demo
DATABASE_TRAJECTORY_DIRECTORY_URL=postgresql://hoox_demo_trajectory_directory:replace-with-password@127.0.0.1:15432/hoox_demo
# 轨迹保留期清理使用与 Worker 相同的对象桶；凭据可独立授权，不使用 Skill Publisher 身份。
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=agent-runtime-demo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-random-s3-user
S3_SECRET_ACCESS_KEY=replace-with-random-s3-password
S3_FORCE_PATH_STYLE=true
