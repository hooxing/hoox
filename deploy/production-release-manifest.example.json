{
  "schemaVersion": 1,
  "releaseId": "<release-id>",
  "apiImageDigest": "sha256:<64-hex-api-image-digest>",
  "schedulerImageDigest": "sha256:<64-hex-scheduler-image-digest>",
  "workerImageDigest": "sha256:<64-hex-worker-image-digest>",
  "sbom": {
    "api": "supply-chain/sbom/api.cdx.json",
    "apiSha256": "<64-hex-api-sbom-sha256>",
    "scheduler": "supply-chain/sbom/scheduler.cdx.json",
    "schedulerSha256": "<64-hex-scheduler-sbom-sha256>",
    "worker": "supply-chain/sbom/worker.cdx.json",
    "workerSha256": "<64-hex-worker-sbom-sha256>"
  },
  "database": {
    "migrationFrom": "<current-migration-id>",
    "migrationTo": "<target-migration-id>",
    "rollbackCompatibleThrough": "<last-backward-compatible-migration-id>"
  },
  "requiredGates": [
    "config:check:production",
    "security:audit:production",
    "supply-chain:check",
    "license:check",
    "release:check",
    "test:production-api:container",
    "test:production-scheduler:container",
    "test:production-worker:container"
  ],
  "rollback": {
    "apiImageDigest": "sha256:<64-hex-previous-api-image-digest>",
    "schedulerImageDigest": "sha256:<64-hex-previous-scheduler-image-digest>",
    "workerImageDigest": "sha256:<64-hex-previous-worker-image-digest>",
    "trigger": "<rollback-trigger-and-threshold>",
    "owner": "<on-call-owner>"
  }
}
