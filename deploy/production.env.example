# 此文件是 production 部署契约示例，不可直接上线；真实值必须由部署平台的秘密管理系统注入。
# 不要复制 development 的 DEV_AUTH_*、MinIO root、bootstrap 或 migration 变量到生产容器。
# production 对非空 NODE_* 默认拒绝，仅允许 NODE_ENV/NODE_VERSION/NODE_EXTRA_CA_CERTS；同时拒绝环境代理、
# SSL_CERT_FILE/SSL_CERT_DIR 与 OPENSSL provider/config 覆盖。私有 CA 仅可按需注入 NODE_EXTRA_CA_CERTS。
RUNTIME_ENV=production
DATABASE_URL=postgresql://agent_runtime:replace-me@postgres.example.invalid:5432/agent_runtime?sslmode=verify-full
DATABASE_RUNTIME_ROLE=agent_runtime
DATABASE_SCHEMA=agent_runtime
PROCESS_SHUTDOWN_TIMEOUT_MS=30000

# API：身份 token 的 sub 仅证明 User；Tenant 始终由 PostgreSQL Membership/RLS 解析，不能写入 token 或环境。
THREAD_CURSOR_ACTIVE_KID=production-current
THREAD_CURSOR_SIGNING_KEYS=replace-with-production-cursor-signing-key-ring
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=3001
# 浏览器/API 对外 origin；对象交付必须使用不同的 S3_PUBLIC_ENDPOINT origin，禁止同源对象代理。
API_PUBLIC_ORIGIN=https://app.example.invalid
API_TLS_MODE=proxy
API_TRUSTED_PROXY_CIDRS=127.0.0.1/32
API_JWT_ISSUER=https://identity.example.invalid
API_JWT_AUDIENCE=cubesandbox-agent-runtime
API_JWT_SIGNING_KEYS=replace-with-production-jwt-signing-key-ring
API_JWT_CLOCK_SKEW_SECONDS=60
API_JWT_MAX_LIFETIME_SECONDS=3600

# 私有对象存储。S3_ENDPOINT 和面向用户的 S3_PUBLIC_ENDPOINT 均必须是无凭据 HTTPS；public origin 必须独立。
S3_ENDPOINT=https://s3.internal.example.invalid
S3_PUBLIC_ENDPOINT=https://downloads.example.invalid
S3_BUCKET=agent-runtime-production
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-production-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-production-s3-secret-key
S3_FORCE_PATH_STYLE=false

# CubeSandbox 控制面与数据面。生产数据面显式 HTTPS，避免端口推导回落为明文。
CUBESANDBOX_API_URL=https://cube-api.example.invalid
CUBESANDBOX_TEMPLATE_ID=replace-with-production-template-id
CUBESANDBOX_API_KEY=replace-with-production-cube-api-key
CUBESANDBOX_PROXY_NODE_IP=192.0.2.10
CUBESANDBOX_PROXY_PORT=443
CUBESANDBOX_PROXY_SCHEME=https

# Scheduler 与 Worker 都是按部署 Tenant 分片的受限后台角色，不能扫描其他 Tenant。
SCHEDULER_TENANT_ID=tenant_production_scheduler
SCHEDULER_WORKER_ID=scheduler_production_01
CLEANUP_POLL_INTERVAL_MS=1000
CLEANUP_LEASE_MS=210000
AGENT_WORKER_TENANT_ID=tenant_production_worker
AGENT_WORKER_ID=agent_worker_production_01
AGENT_WORKER_POLL_INTERVAL_MS=1000
AGENT_WORKER_DISPATCH_LEASE_MS=30000
AGENT_WORKER_RUN_LEASE_MS=30000

# 模型 Provider；生产 Worker 将校验 /models 的 context window 与最大输出元数据。
MODEL_BASE_URL=https://model.example.invalid/v1
MODEL_API_KEY=replace-with-production-model-api-key
MODEL_ID=replace-with-production-model-id
MODEL_CONTEXT_WINDOW=128000
MODEL_MAX_OUTPUT_TOKENS=16384
# 默认关闭；启用前须确认租户数据保留与维护者访问授权。
MODEL_WIRE_TRACE_ENABLED=false
MODEL_WIRE_TRACE_RETENTION_DAYS=7
# 最终 Fetch request body，或 HTTP content-decoding 后、SSE 解析前 response body 的诊断保存上限（超过后保留前缀和截断状态）。
MODEL_WIRE_TRACE_MAX_BYTES=1048576
