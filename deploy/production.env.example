# 此文件是 production 部署契约示例，不可直接上线；真实值必须由部署平台的秘密管理系统注入。
# 不要复制 development 的 DEV_AUTH_*、MinIO root、bootstrap 或 migration 变量到生产容器。
# production 对非空 NODE_* 默认拒绝，仅允许 NODE_ENV/NODE_VERSION/NODE_EXTRA_CA_CERTS；同时拒绝环境代理、
# SSL_CERT_FILE/SSL_CERT_DIR 与 OPENSSL provider/config 覆盖。私有 CA 仅可按需注入 NODE_EXTRA_CA_CERTS。
RUNTIME_ENV=production
DATABASE_URL=postgresql://agent_runtime:replace-me@postgres.example.invalid:5432/agent_runtime?sslmode=verify-full
DATABASE_RUNTIME_ROLE=agent_runtime
DATABASE_SKILL_PUBLISHER_ROLE=agent_skill_publisher
DATABASE_SCHEMA=agent_runtime
PROCESS_SHUTDOWN_TIMEOUT_MS=30000

# API：身份 token 的 sub 仅证明 User；Tenant 始终由 PostgreSQL Membership/RLS 解析，不能写入 token 或环境。
THREAD_CURSOR_ACTIVE_KID=production-current
THREAD_CURSOR_SIGNING_KEYS=replace-with-production-cursor-signing-key-ring
THREAD_SERIAL_QUEUE_V2_ENABLED=true
THREAD_CONTEXT_V2_WRITE_ENABLED=true
THREAD_CONTEXT_V2_SHADOW_READ_ENABLED=true
THREAD_CONTEXT_V2_READ_ENABLED=true
THREAD_INPUT_ROUTING_V2_ENABLED=true
THREAD_CONTEXT_INLINE_BODY_MAX_BYTES=16384
THREAD_CONTEXT_COMPACTION_ENABLED=true
THREAD_CONTEXT_COMPACTION_PATH=local
THREAD_CONTEXT_COMPACTION_SOFT_LIMIT_PERCENT=80
THREAD_CONTEXT_COMPACTION_TARGET_PERCENT=55
THREAD_CONTEXT_COMPACTION_RECENT_USER_TOKENS=4096
THREAD_CONTEXT_COMPACTION_MAX_OUTPUT_TOKENS=2048
THREAD_CONTEXT_COMPACTION_TIMEOUT_MS=60000
THREAD_SANDBOX_SESSION_REUSE_ENABLED=true
SUBAGENTS_ENABLED=true
THREAD_SANDBOX_RETENTION_SCHEDULER_ENABLED=true
CUBESANDBOX_SESSION_TTL_SECONDS=43800
THREAD_SANDBOX_PAUSED_RETENTION_SECONDS=86400
THREAD_SANDBOX_LIFECYCLE_TIMEOUT_MS=90000
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=3001
# 浏览器/API 对外 origin；对象交付必须使用不同的 S3_PUBLIC_ENDPOINT origin，禁止同源对象代理。
API_PUBLIC_ORIGIN=https://app.example.invalid
API_TLS_MODE=proxy
API_TRUSTED_PROXY_CIDRS=127.0.0.1/32
API_JWT_ISSUER=https://identity.example.invalid
API_JWT_AUDIENCE=cubesandbox-agent-runtime
API_JWT_SIGNING_KEYS=replace-with-production-jwt-signing-key-ring
API_JWT_CLOCK_SKEW_SECONDS=60
API_JWT_MAX_LIFETIME_SECONDS=3600
# Cubelet 宿主机 Volume 插件访问只读 WebDAV 边界；Sandbox 不持有网络令牌或 MinIO 凭据。
RESOURCE_FILESYSTEM_SIGNING_KEY=replace-with-production-resource-filesystem-signing-key
HISTORY_FILESYSTEM_ENABLED=true
HISTORY_DIRECTORY_TIME_ZONE=Asia/Shanghai
# personal Tenant 标题由 Scheduler 使用独立低成本模型生成；请求只含受限首条原文与附件元数据。
HISTORY_TITLE_GENERATION_ENABLED=true
HISTORY_TITLE_MODEL_BASE_URL=https://title-model.example.invalid/v1
HISTORY_TITLE_MODEL_API_KEY=replace-with-production-title-model-api-key
HISTORY_TITLE_MODEL_ID=replace-with-production-title-model-id
HISTORY_TITLE_MODEL_TIMEOUT_MS=20000
HISTORY_TITLE_INPUT_MAX_BYTES=4096
HISTORY_TITLE_MAX_OUTPUT_TOKENS=128
HISTORY_TITLE_MAX_ATTEMPTS=3
HISTORY_TITLE_RETRY_BASE_MS=5000
HISTORY_TITLE_POLL_INTERVAL_MS=1000
HISTORY_TITLE_CLAIM_LEASE_MS=60000

# 私有对象存储。S3_ENDPOINT 和面向用户的 S3_PUBLIC_ENDPOINT 均必须是无凭据 HTTPS；public origin 必须独立。
S3_ENDPOINT=https://s3.internal.example.invalid
S3_PUBLIC_ENDPOINT=https://downloads.example.invalid
S3_BUCKET=agent-runtime-production
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-production-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-production-s3-secret-key
S3_FORCE_PATH_STYLE=false

# Skill 管理发布面独立部署：身份 audience、数据库登录和对象存储凭据均不得与普通 Runtime 复用。
SKILL_PUBLISHER_DATABASE_URL=postgresql://agent_skill_publisher:replace-me@postgres.example.invalid:5432/agent_runtime?sslmode=verify-full
SKILL_ADMIN_LISTEN_HOST=127.0.0.1
SKILL_ADMIN_LISTEN_PORT=3002
SKILL_ADMIN_TLS_MODE=proxy
SKILL_ADMIN_TLS_TRUSTED_PROXY_CIDRS=127.0.0.1/32
SKILL_ADMIN_JWT_ISSUER=https://identity.example.invalid
SKILL_ADMIN_JWT_AUDIENCE=cube-runtime-skill-admin
SKILL_ADMIN_JWT_SIGNING_KEYS=replace-with-production-skill-admin-jwt-signing-key-ring
SKILL_ADMIN_JWT_CLOCK_SKEW_SECONDS=60
SKILL_ADMIN_JWT_MAX_LIFETIME_SECONDS=3600
SKILL_PUBLISHER_S3_ENDPOINT=https://s3.internal.example.invalid
SKILL_PUBLISHER_S3_BUCKET=agent-runtime-production
SKILL_PUBLISHER_S3_REGION=us-east-1
SKILL_PUBLISHER_S3_ACCESS_KEY_ID=replace-with-production-skill-publisher-access-key
SKILL_PUBLISHER_S3_SECRET_ACCESS_KEY=replace-with-production-skill-publisher-secret-key
SKILL_PUBLISHER_S3_FORCE_PATH_STYLE=false

# CubeSandbox 控制面与数据面。生产数据面显式 HTTPS，避免端口推导回落为明文。
CUBESANDBOX_API_URL=https://cube-api.example.invalid
CUBESANDBOX_TEMPLATE_ID=replace-with-production-template-id
CUBESANDBOX_API_KEY=replace-with-production-cube-api-key
CUBESANDBOX_PROXY_NODE_IP=192.0.2.10
CUBESANDBOX_RESOURCE_VOLUME_DRIVER=runtime-resourcefs
CUBESANDBOX_PROXY_PORT=443
CUBESANDBOX_PROXY_SCHEME=https

# Scheduler 与 Worker 都是按部署 Tenant 分片的受限后台角色，不能扫描其他 Tenant。
SCHEDULER_TENANT_ID=tenant_production_scheduler
SCHEDULER_WORKER_ID=scheduler_production_01
CLEANUP_POLL_INTERVAL_MS=1000
CLEANUP_LEASE_MS=210000
AGENT_WORKER_TENANT_ID=tenant_production_worker
AGENT_WORKER_ID=agent_worker_production_01
AGENT_WORKER_POLL_INTERVAL_MS=1000
AGENT_WORKER_DISPATCH_LEASE_MS=30000
AGENT_WORKER_RUN_LEASE_MS=30000
AGENT_WORKER_RUN_TIMEOUT_MS=43200000

# 模型 Provider；生产 Worker 将校验 /models 的 context window 与最大输出元数据。
MODEL_BASE_URL=https://model.example.invalid/v1
MODEL_API_KEY=replace-with-production-model-api-key
MODEL_ID=replace-with-production-model-id
# 必须与实际模型能力一致；true 时当前 user turn 的图片以 Pi ImageContent 内联提交。
MODEL_SUPPORTS_IMAGES=false
MODEL_CONTEXT_WINDOW=128000
MODEL_MAX_OUTPUT_TOKENS=16384
# 默认关闭；启用前须确认租户数据保留与维护者访问授权。
MODEL_WIRE_TRACE_ENABLED=false
MODEL_WIRE_TRACE_RETENTION_DAYS=7
# 最终 Fetch request body，或 HTTP content-decoding 后、SSE 解析前 response body 的诊断保存上限（超过后保留前缀和截断状态）。
MODEL_WIRE_TRACE_MAX_BYTES=1048576
