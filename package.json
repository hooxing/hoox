{
  "name": "cubesandbox-agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --sort --if-present build",
    "clean": "pnpm --recursive --if-present clean",
    "config:check": "node scripts/validate-env-example.mjs && docker compose --env-file .env.example -f docker-compose.dev.yml config --quiet",
    "check:clean-workspace": "node scripts/remove-workspace-dist.mjs && pnpm check",
    "check:clean-vendor": "pnpm check:clean-workspace",
    "db:migrate:up": "pnpm --filter @cube-runtime/persistence build && node --env-file-if-exists=.env runtime-ts/packages/persistence/dist/cli.js up",
    "db:migrate:down": "pnpm --filter @cube-runtime/persistence build && node --env-file-if-exists=.env runtime-ts/packages/persistence/dist/cli.js down --allow-destructive",
    "dev:identity:provision": "pnpm --filter @cube-runtime/api^... build && pnpm --filter @cube-runtime/api dev:identity:provision",
    "dev:api": "pnpm --filter @cube-runtime/api^... build && pnpm --filter @cube-runtime/api dev",
    "dev:worker": "pnpm --filter @cube-runtime/agent-worker^... build && pnpm --filter @cube-runtime/agent-worker dev",
    "dev:worker:check": "pnpm --filter @cube-runtime/agent-worker^... build && pnpm --filter @cube-runtime/agent-worker dev:preflight",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "pnpm build && vitest run",
    "test:cube:real": "pnpm --filter @cubesandbox/sdk build && tsx runtime-ts/packages/sandbox/src/real-smoke.ts",
    "test:pi-cube:real": "pnpm build && tsx runtime-ts/packages/pi-adapter/src/real-vertical-smoke.ts",
    "test:pi-prompt:container": "node scripts/run-pi-prompt-container-gate.mjs",
    "test:integration:pg": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "build:m4-runtime-dependencies": "pnpm --filter \"@cube-runtime/api^...\" --filter \"@cube-runtime/agent-worker^...\" --filter \"@cube-runtime/scheduler^...\" build",
    "test:integration:m4": "pnpm build:m4-runtime-dependencies && vitest run --config vitest.integration.config.ts tests/integration/postgres-run-worker.integration.test.ts",
    "test:integration:m4:clean": "node scripts/remove-workspace-dist.mjs && pnpm test:integration:m4",
    "build:process-runtime-dependencies": "pnpm --filter \"@cube-runtime/api^...\" --filter \"@cube-runtime/agent-worker^...\" --filter \"@cube-runtime/scheduler^...\" build",
    "test:process-runtime": "pnpm build:process-runtime-dependencies && vitest run runtime-ts/packages/process-runtime/src runtime-ts/apps/api/src/process-entry.test.ts runtime-ts/apps/agent-worker/src/process-entry.test.ts runtime-ts/apps/scheduler/src/process-entry.test.ts",
    "test:process-runtime:clean": "node scripts/remove-workspace-dist.mjs && pnpm test:process-runtime",
    "test:process:container": "pnpm --filter @cube-runtime/process-runtime build && node scripts/run-process-container-gate.mjs",
    "typecheck": "pnpm build && tsc -p tsconfig.json && pnpm --recursive --sort --if-present typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm config:check"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@aws-sdk/client-s3": "3.1095.0",
    "@cube-runtime/domain": "workspace:*",
    "@cube-runtime/protocol-mapper": "workspace:*",
    "@cube-runtime/persistence": "workspace:*",
    "@cube-runtime/resource": "workspace:*",
    "@cube-runtime/run-contracts": "workspace:*",
    "@cube-runtime/sandbox": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "24.10.0",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "tsx": "4.20.6"
  }
}
