{
  "name": "@cube-runtime/agent-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../../.env dist/development-main.js",
    "dev:preflight": "node --env-file-if-exists=../../../.env dist/development-preflight-main.js",
    "start:production": "node dist/production-main.js"
  },
  "dependencies": {
    "@cube-runtime/context-policy": "workspace:*",
    "@cube-runtime/artifact": "workspace:*",
    "@cube-runtime/domain": "workspace:*",
    "@cube-runtime/pi-adapter": "workspace:*",
    "@cube-runtime/persistence": "workspace:*",
    "@cube-runtime/process-runtime": "workspace:*",
    "@cube-runtime/run-contracts": "workspace:*",
    "@cube-runtime/resource": "workspace:*",
    "@cube-runtime/sandbox": "workspace:*",
    "@cube-runtime/skill": "workspace:*",
    "@cube-runtime/tool-router": "workspace:*",
    "@cube-runtime/workspace": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1"
  }
}
