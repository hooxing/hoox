{
  "name": "@hoox/agent-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/development-main.js",
    "dev:preflight": "node dist/development-preflight-main.js",
    "start:production": "node dist/production-main.js"
  },
  "dependencies": {
    "@hoox/artifact": "workspace:*",
    "@hoox/context-policy": "workspace:*",
    "@hoox/domain": "workspace:*",
    "@hoox/memory": "workspace:*",
    "@hoox/persistence": "workspace:*",
    "@hoox/pi-adapter": "workspace:*",
    "@hoox/process-runtime": "workspace:*",
    "@hoox/resource": "workspace:*",
    "@hoox/run-contracts": "workspace:*",
    "@hoox/sandbox": "workspace:*",
    "@hoox/skill": "workspace:*",
    "@hoox/tool-router": "workspace:*",
    "@hoox/trajectory": "workspace:*",
    "@hoox/workspace": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@hoox/automation": "workspace:*"
  }
}
