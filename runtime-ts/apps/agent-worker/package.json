{
  "name": "@aisay/agent-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/development-main.js",
    "dev:preflight": "node dist/development-preflight-main.js",
    "start:production": "node dist/production-main.js"
  },
  "dependencies": {
    "@aisay/artifact": "workspace:*",
    "@aisay/context-policy": "workspace:*",
    "@aisay/domain": "workspace:*",
    "@aisay/memory": "workspace:*",
    "@aisay/persistence": "workspace:*",
    "@aisay/pi-adapter": "workspace:*",
    "@aisay/process-runtime": "workspace:*",
    "@aisay/resource": "workspace:*",
    "@aisay/run-contracts": "workspace:*",
    "@aisay/sandbox": "workspace:*",
    "@aisay/skill": "workspace:*",
    "@aisay/tool-router": "workspace:*",
    "@aisay/trajectory": "workspace:*",
    "@aisay/workspace": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@aisay/automation": "workspace:*"
  }
}
