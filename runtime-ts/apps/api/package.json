{
  "name": "@cube-runtime/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cube-runtime/domain": "workspace:*",
    "@cube-runtime/persistence": "workspace:*",
    "@cube-runtime/process-runtime": "workspace:*",
    "@cube-runtime/protocol": "workspace:*",
    "@cube-runtime/protocol-mapper": "workspace:*",
    "@cube-runtime/resource": "workspace:*",
    "@cube-runtime/skill": "workspace:*",
    "fastify": "5.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../../.env dist/development-main.js",
    "dev:identity:provision": "node --env-file-if-exists=../../../.env dist/development-identity-main.js",
    "start:production": "node dist/production-main.js"
  }
}
