{
  "name": "@hoox/scheduler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@hoox/domain": "workspace:*",
    "@hoox/persistence": "workspace:*",
    "@hoox/process-runtime": "workspace:*",
    "@hoox/sandbox": "workspace:*",
    "@hoox/thread-title": "workspace:*",
    "@hoox/tool-router": "workspace:*",
    "pg": "8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node dist/development-main.js",
    "start:production": "node dist/production-main.js",
    "smoke:cleanup:real": "node --env-file-if-exists=../../../.env --import tsx src/cleanup-real-smoke.ts"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
