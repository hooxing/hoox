{
  "name": "@hoox/chat-ui",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown-view.d.ts",
      "default": "./dist/markdown-view.js"
    },
    "./assistant-message": {
      "types": "./dist/assistant-message.d.ts",
      "default": "./dist/assistant-message.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:built": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../../.. runtime-ts/packages/chat-ui"
  },
  "dependencies": {
    "@hoox/sdk": "workspace:*",
    "@hoox/ui-theme": "workspace:*",
    "@hoox/vendor-deepseek-markdown": "workspace:*",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "peerDependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
