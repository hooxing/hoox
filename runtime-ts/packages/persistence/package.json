    "@aisay/run-contracts": "workspace:*",
    "@aisay/skill": "workspace:*",
    "@aisay/thread-title": "workspace:*",
    "@aisay/workspace": "workspace:*",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
