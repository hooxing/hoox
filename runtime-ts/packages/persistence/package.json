{
  "name": "@aisay/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
