{
  "name": "@hoox/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "prepare:ci:m4": "tsx scripts/prepare-m4-ci-database.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test:integration:minio": "vitest run --root ../../.. runtime-ts/packages/persistence/src/s3-minio.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@hoox/admin-control": "workspace:*",
    "@hoox/automation": "workspace:*",
    "@hoox/context-policy": "workspace:*",
    "@hoox/domain": "workspace:*",
    "@hoox/identity": "workspace:*",
    "@hoox/memory": "workspace:*",
    "@hoox/resource": "workspace:*",
    "@hoox/run-contracts": "workspace:*",
    "@hoox/skill": "workspace:*",
    "@hoox/thread-title": "workspace:*",
    "@hoox/workspace": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
