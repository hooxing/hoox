{
  "name": "@aisay/pi-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aisay/context-policy": "workspace:*",
    "@aisay/domain": "workspace:*",
    "@aisay/prompt-builder": "workspace:*",
    "@aisay/sandbox": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@huggingface/tokenizers": "0.1.3",
    "typebox": "1.1.38",
    "@aisay/automation": "workspace:*"
  }
}
