{
  "name": "@hoox/pi-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./thread-history": {
      "types": "./src/thread-history.ts",
      "default": "./dist/thread-history.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@hoox/context-policy": "workspace:*",
    "@hoox/domain": "workspace:*",
    "@hoox/prompt-builder": "workspace:*",
    "@hoox/sandbox": "workspace:*",
    "@earendil-works/pi-ai": "0.82.1",
    "@huggingface/tokenizers": "0.1.3",
    "typebox": "1.1.38",
    "@hoox/automation": "workspace:*",
    "@hoox/vendor-deepseek-v4-tokenizer": "workspace:*"
  }
}
