{
  "name": "@hoox/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./file-references": {
      "types": "./src/file-references.ts",
      "default": "./dist/file-references.js"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pi-model-catalog": {
      "types": "./src/pi-model-catalog.ts",
      "default": "./dist/pi-model-catalog.js"
    }
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
