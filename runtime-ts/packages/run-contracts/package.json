{
  "name": "@hoox/run-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mutation-protocol": {
      "types": "./src/mutation-protocol.ts",
      "default": "./dist/mutation-protocol.js"
    },
    "./rollout-projection": {
      "types": "./src/rollout-projection.ts",
      "default": "./dist/rollout-projection.js"
    },
    "./runtime-agent-event": {
      "types": "./src/runtime-agent-event.ts",
      "default": "./dist/runtime-agent-event.js"
    },
    "./sandbox-port": {
      "types": "./src/sandbox-port.ts",
      "default": "./dist/sandbox-port.js"
    },
    "./thread-history": {
      "types": "./src/thread-history.ts",
      "default": "./dist/thread-history.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hoox/context-policy": "workspace:*",
    "@hoox/domain": "workspace:*",
    "@hoox/skill": "workspace:*",
    "@hoox/workspace": "workspace:*"
  }
}
