{
  "name": "@hoox/ui-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./theme.css": "./theme.css",
    "./branding": {
      "types": "./branding.tsx",
      "default": "./dist/branding.js"
    }
  },
  "files": [
    "theme.css",
    "dist"
  ],
  "dependencies": {
    "@hoox/protocol": "workspace:*",
    "react": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "react-dom": "19.1.1",
    "jsdom": "26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "test": "vitest run --root ../../.. runtime-ts/packages/ui-theme",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:built": "tsc -p tsconfig.json --noEmit"
  }
}
